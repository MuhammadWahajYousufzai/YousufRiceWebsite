# Copy to .env.googleplay.local. Never commit the local file or keystore.
YOUSUF_RICE_UPLOAD_STORE_FILE=/Users/muhammadwahaj/keys/yousuf-rice/yousuf-rice-upload.jks
YOUSUF_RICE_UPLOAD_KEY_ALIAS=yousuf-rice-upload

# On macOS, the build script reads the password from this Keychain entry.
YOUSUF_RICE_KEYCHAIN_SERVICE="Yousuf Rice Google Play Upload Key"
YOUSUF_RICE_KEYCHAIN_ACCOUNT=com.yousufrice.mobile

# CI may set these securely instead of using macOS Keychain.
# YOUSUF_RICE_UPLOAD_STORE_PASSWORD=
# YOUSUF_RICE_UPLOAD_KEY_PASSWORD=

# Current Google Play upload certificate. The build script refuses mismatches.
YOUSUF_RICE_EXPECTED_UPLOAD_SHA1=E6:21:48:F5:4D:15:C8:1D:0B:3B:B3:34:14:A3:6F:71:29:33:F9:95
