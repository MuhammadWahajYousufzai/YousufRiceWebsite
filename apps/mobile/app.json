{
  "expo": {
    "name": "Yousuf Rice",
    "slug": "yousuf-rice-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yousufrice",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.yousufrice.mobile",
      "buildNumber": "3",
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Yousuf Rice uses your location only when you choose Use GPS, so riders can find your delivery address accurately."
      }
    },
    "android": {
      "package": "com.yousufrice.mobile",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7FC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Yousuf Rice to use your location to save accurate delivery coordinates for your order."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#27247B",
          "defaultChannel": "orders"
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
