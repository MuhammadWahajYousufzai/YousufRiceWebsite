# Copy this file to .env.appstoreconnect.local and fill in the real values.
# Keep .env.appstoreconnect.local and AuthKey_*.p8 private.

# App Store Connect API key identifier, for example ABCD123456.
ASC_KEY_ID=

# App Store Connect issuer identifier, a UUID from Users and Access > Integrations.
ASC_ISSUER_ID=

# Optional. Defaults to ./AuthKey_${ASC_KEY_ID}.p8 next to this file.
ASC_KEY_PATH=

# Apple Developer team already configured in the iOS project.
APPLE_TEAM_ID=V4AYP7YKGS

# Appwrite APNs provider used by App Store/TestFlight builds.
EXPO_PUBLIC_APPWRITE_IOS_PUSH_PROVIDER_ID=ios_apns

EXPO_PUBLIC_APPWRITE_STOREFRONT_CONTENT_TABLE_ID=storefront_content
